# What `npx lo` (see lo.js) does on every run: npm installs this package into
# its own cache to find the bin, and an install audits its dependencies against
# registry.npmjs.org. That is a network round trip nobody asked for on the way
# to reading a table off the local database — and on a machine that reaches
# the registry slowly, or not at all, it is a spinner that never stops. Off,
# along with the other two things npm phones home for: the weekly check for a
# newer npm, and the funding notice.
audit=false
fund=false
update-notifier=false
