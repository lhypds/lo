PORT=3014
PM2_NAME=lo
# The only credential lo needs: every server-side upstream is key-free.
VITE_MAPBOX_TOKEN=
# Where a reader who has forgotten their password is sent to ask for a new one.
# lo cannot reset one itself — an account is a name and a password and no address
# to send anything to — so the login screen offers this one instead, and whoever
# reads that inbox sets the new password in the users table by hand. Left empty,
# the button says as much and asks for nothing.
VITE_ADMIN_EMAIL=
